# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in your Supabase credentials:
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# On Streamlit Community Cloud:
# Paste these settings into the "Secrets" box in your app's dashboard settings.

# Supabase Free Tier Configuration
# Find these in your Supabase Project Dashboard -> Project Settings -> API
SUPABASE_URL = "https://your-project-ref.supabase.co"

# IMPORTANT: Use ONLY the public 'anon' key here.
# NEVER use or paste the 'service_role' secret key into client apps!
SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Optional: Alternative nested format is also supported
# [supabase]
# url = "https://your-project-ref.supabase.co"
# anon_key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"
